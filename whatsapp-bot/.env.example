# URL del endpoint de Elim IA en elimlldm.net (déjalo así salvo que pruebes en local)
ELIM_API_URL=https://elimlldm.net/api/whatsapp/chat
ELIM_CLEAR_URL=https://elimlldm.net/api/whatsapp/clear

# Debe ser EXACTAMENTE el mismo valor que WHATSAPP_BOT_SECRET en el
# .env.local / Vercel de elim-lldm (la app Next.js)
WHATSAPP_BOT_SECRET=generate-with-openssl-rand-hex-32

# true si quieres que también responda en grupos de WhatsApp (por defecto no)
RESPOND_IN_GROUPS=false

# Cuánto espera el bot antes de contestar, para darte tiempo a responder
# tú mismo desde tu propio WhatsApp (vinculado al mismo número). Si
# contestas antes de que pase esto, la respuesta automática se cancela.
# Default: 5 minutos.
AUTO_REPLY_DELAY_MS=300000

# Límite de mensajes por número antes de pedirle que espere
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=300000

# Se define solo, no lo toques a mano — lo pone el Dockerfile
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
